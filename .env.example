# Copy this file to .env.local and fill in your own values.
# Never commit .env or .env.local — they are listed in .gitignore.

# OAuth 2.0 Client ID from Google Cloud Console (APIs & Services > Credentials).
# This is a public identifier, safe to ship to the browser, but keep it
# specific to this project rather than reusing one from another app.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# The spreadsheet ID from your Google Sheet's URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
VITE_GOOGLE_SHEET_ID=your-google-sheet-id

# The only Google account email allowed to use this app.
# SpendFlow is single-user — any other authenticated account is denied access.
VITE_ALLOWED_GOOGLE_EMAIL=you@example.com
