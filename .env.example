# Copy this file to .env.local and fill in your own values.
# Never commit .env or .env.local — they are listed in .gitignore.

# The Google Apps Script web-app URL (ends in /exec). Deploy docs/apps-script/Code.gs
# from your spreadsheet as described in docs/GOOGLE_SHEETS_SETUP.md.
# Keep it private: with app protection off, anyone with this URL can reach your sheet.
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec
